<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>worf_create_subscriber</AssemblyName>
    <RootNamespace>Worf.CreateSubscriber</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);WORF_FRONTEND</DefineConstants>
    <!-- The command keeps pglogical_create_subscriber's name, so its assembly name has underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Worf/Fe.cs" Link="Fe.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
